# Copy to .env (gitignored). Never commit real tokens.
#
# Option A — direct TF vars:
# TF_VAR_coolify_api_token=tcp-...
# TF_VAR_openbao_token=hvs....
# TF_VAR_openbao_address=https://bao.example.com:8200
#
# Option B — OpenBao export (Justfile uses this when VAULT_ADDR is set):
# Must include https:// — bare hostnames break bao/vault CLI (unsupported protocol scheme "").
VAULT_ADDR=https://secrets.bdziam.dev
VAULT_TOKEN=

# Seed OpenBao from GitHub vars + config/openbao-secrets.env:
#   cp config/openbao-secrets.env.example config/openbao-secrets.env
#   ./scripts/seed-openbao-from-gh.sh
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

COOLIFY_API_TOKEN=
