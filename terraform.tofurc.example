# Copy to terraform.tofurc or run scripts/ci/install-coolify-provider.sh (writes terraform.tofurc.generated).
provider_installation {
  filesystem_mirror {
    path    = "$HOME/.terraform.d/plugins"
    include = ["registry.terraform.io/arcusis/coolify"]
  }
  direct {
    exclude = ["registry.terraform.io/arcusis/coolify"]
  }
}
