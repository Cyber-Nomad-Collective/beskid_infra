# Copy to config/production.tfvars (gitignored)

coolify_endpoint = "https://coolify.bdziam.dev"

# OpenTofu creates the project — do not set project_uuid on first apply.
manage_coolify_project      = true
coolify_project_name        = "Beskid"
coolify_project_description = "Beskid platform — OpenTofu greenfield"

server_uuid = "ec0cs0cw0ocsok488gc0k80k"

manage_environment = true
deploy_openbao     = true
instant_deploy     = true

openbao_enabled      = false
seed_openbao_secrets = false

enable_services = {
  site    = true
  auth    = true
  tracker = false
  nexus   = false
  pckg    = false
}
