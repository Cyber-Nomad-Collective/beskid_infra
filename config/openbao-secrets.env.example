# Copy to config/openbao-secrets.env (gitignored).
# GitHub CLI can list secret names but cannot read secret values — paste from
# GitHub → Settings → Secrets and variables → Actions, or from Coolify → Keys & Tokens.
#
#   cp config/openbao-secrets.env.example config/openbao-secrets.env

# OpenBao admin (root or policy with write on secret/beskid/*)
OPENBAO_TOKEN=

# Coolify API token — quote if it contains | (e.g. COOLIFY_API_TOKEN='7|...')
COOLIFY_API_TOKEN=

# Optional: GitHub OAuth for auth hub (or configure via /onboarding in the UI)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CI build lane (secret/beskid/ci/build)
NODE_AUTH_TOKEN=
OVSX_TOKEN=

# Optional overrides when seeding pckg
# PCKG_POSTGRES_PASSWORD=

# platform-spec git export (secret/beskid/{lane}/platform-spec)
# GITHUB_SYNC_TOKEN=
# PLATFORM_SPEC_PAIRING_APPROVER_LOGIN=
# PLATFORM_SPEC_MODERATOR_LOGINS=

# Nexus code-doc pipeline (OpenBao: secret/beskid/{lane}/nexus)
OPENROUTER_API_KEY=
