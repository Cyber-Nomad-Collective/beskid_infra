# Non-secret defaults for local `docker compose config` validation.
# Production secrets live in OpenBao; Coolify service env is synced by CI.

IMAGE_TAG=main
AUTH_HUB_PUBLIC_URL=https://auth.beskid-lang.org
TRACKER_PUBLIC_URL=https://tracker.beskid-lang.org
SESSION_SECRET=local-dev-only
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=pckgdb
POSTGRES_USER=postgres
PCKG_DATABASE_URL=postgres://postgres:local-dev-only@postgres:5432/pckgdb
PCKG_RELEASE_PUBLISHER_KEY_SHA256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

# Enable optional stack services (matches OpenBao paths synced — see coolify-production.json)
COMPOSE_PROFILES=tracker,nexus,pckg
